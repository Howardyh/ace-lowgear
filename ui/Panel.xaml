<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACE LowGear · 控制中心" Width="1060" Height="800" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
  <SolidColorBrush x:Key="SubtleBrush" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="SecondaryBrush" Color="#606060"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#DFDFDF"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="PressedBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#E8F1FA"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
  <SolidColorBrush x:Key="SuccessFillBrush" Color="#EAF4E9"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#805400"/>
  <SolidColorBrush x:Key="WarningFillBrush" Color="#FFF4CE"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#B10E1E"/>
  <SolidColorBrush x:Key="ErrorFillBrush" Color="#FDE7E9"/>
  <Geometry x:Key="CheckIcon">M 2,8 L 6,12 L 14,3</Geometry>
  <Geometry x:Key="ClockIcon">M 8,1 A 7,7 0 1 1 7.99,1 M 8,4 L 8,8 L 11,10</Geometry>
  <Geometry x:Key="WarningIcon">M 8,1 L 15,14 L 1,14 Z M 8,5 L 8,9 M 8,11 L 8,12</Geometry>
  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="5" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
   <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></Style>
  <Style x:Key="NavButton" TargetType="RadioButton">
   <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavBorder" Background="Transparent" CornerRadius="6"><Grid><Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/><ContentPresenter Margin="14,0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource SecondaryBrush}" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"><Path x:Name="Tick" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="4"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollRepeat" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollRepeat}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="{DynamicResource SecondaryBrush}" CornerRadius="3" Margin="4,2" MinHeight="24" Opacity="0.55"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollRepeat}"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="StatusLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="StatusIcon" TargetType="Path"><Setter Property="Data" Value="{StaticResource ClockIcon}"/><Setter Property="Stroke" Value="{DynamicResource SecondaryBrush}"/><Setter Property="StrokeThickness" Value="1.5"/><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Margin" Value="0,0,6,0"/><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Data" Value="{StaticResource CheckIcon}"/><Setter Property="Stroke" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Data" Value="{StaticResource WarningIcon}"/><Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Data" Value="{StaticResource WarningIcon}"/><Setter Property="Stroke" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ProcessExpander" TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><ToggleButton Foreground="{DynamicResource TextBrush}" Background="Transparent" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" AutomationProperties.Name="{Binding Image}" FocusVisualStyle="{StaticResource FocusRing}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="16,12"><Grid><ContentPresenter Margin="0,0,28,0"/><Path x:Name="Chevron" Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{Binding Header,RelativeSource={RelativeSource TemplatedParent}}" ContentTemplate="{Binding HeaderTemplate,RelativeSource={RelativeSource TemplatedParent}}"/></ToggleButton><ContentPresenter x:Name="ProcessDetails" ContentSource="Content" Visibility="Collapsed" Margin="16,0,16,16"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ProcessDetails" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="RootGrid">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Margin="12,24,12,16">
   <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="12,0,0,0"><TextBlock x:Name="BrandText" Text="ACE LowGear" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="BrandCaption" Text="启动时设置 · 核验后退出" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Grid.Row="1">
    <RadioButton x:Name="OverviewNav" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" ToolTip="概览" AutomationProperties.Name="概览"><StackPanel Orientation="Horizontal"><Path Data="M 1,1 L 7,1 L 7,7 L 1,7 Z M 11,1 L 17,1 L 17,7 L 11,7 Z M 1,11 L 7,11 L 7,17 L 1,17 Z M 11,11 L 17,11 L 17,17 L 11,17 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" Width="18" Height="18"/><TextBlock x:Name="OverviewNavLabel" Text="概览" Margin="14,0,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" ToolTip="设置" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><Path Data="M 0,4 L 18,4 M 0,13 L 18,13 M 5,0 L 5,8 M 13,9 L 13,17" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="18" Height="18"/><TextBlock x:Name="SettingsNavLabel" Text="设置" Margin="14,0,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="DiagnosticsNav" GroupName="Navigation" Style="{StaticResource NavButton}" ToolTip="诊断" AutomationProperties.Name="诊断"><StackPanel Orientation="Horizontal"><Path Data="M 1,9 L 4,9 L 7,2 L 11,16 L 14,9 L 18,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="18" Height="18"/><TextBlock x:Name="DiagnosticsNavLabel" Text="诊断" Margin="14,0,0,0"/></StackPanel></RadioButton>
   </StackPanel>
   <StackPanel Grid.Row="2" Margin="12,0,0,0"><TextBlock x:Name="MaterialText" Text="背景：实色" Style="{StaticResource Caption}"/><TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock x:Name="PreviewBadge" Text="示例数据 · 非实际状态" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <Border Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0">
   <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="概览" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageCaption" Text="查看自动执行与当前进程的实际状态。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" ToolTip="立即执行完整检查" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="刷新状态"/></Grid>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
       <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="自动执行配置" Style="{StaticResource Caption}"/><TextBlock x:Name="ManagerText" Text="正在读取…" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ManagerHint" Text="配置与进程读值分别检查" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="当前进程核验" Style="{StaticResource Caption}"/><StackPanel x:Name="LiveStatus" Orientation="Horizontal" Margin="0,8,0,0"><Path Style="{StaticResource StatusIcon}"/><TextBlock x:Name="LiveText" Text="等待检查" FontSize="20" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="SummaryText" Text="正在检查…" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
       </Grid>
       <TextBlock x:Name="GuideText" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
       <WrapPanel Margin="0,0,0,20"><Button x:Name="PrimaryButton" Content="启用自动管理" Style="{StaticResource PrimaryButton}"/><Button x:Name="ApplyButton" Content="立即应用一次"/><Button x:Name="OpenSettingsButton" Content="调整策略"/></WrapPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="目标进程" FontSize="16" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="目标：CPU 低 / I/O 非常低" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid>
       <ItemsControl x:Name="ProcessesList">
        <ItemsControl.ItemTemplate><DataTemplate><Expander IsExpanded="{Binding Expanded,Mode=TwoWay}" Style="{StaticResource ProcessExpander}" AutomationProperties.Name="{Binding Image}">
         <Expander.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Image}" FontWeight="SemiBold"/><TextBlock Text="{Binding InstanceLabel}" Style="{StaticResource Caption}" Margin="12,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Path Style="{StaticResource StatusIcon}"/><TextBlock Text="{Binding Status}" Style="{StaticResource StatusLabel}"/></StackPanel><WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"><TextBlock Text="CPU" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Cpu}" FontSize="12" Margin="8,0,20,0"/><TextBlock Text="I/O" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Io}" FontSize="12" Margin="8,0,20,0"/><TextBlock Text="相关性" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Affinity}" FontSize="12" Margin="8,0,0,0"/></WrapPanel></Grid></Expander.Header>
         <StackPanel><TextBlock Text="程序未运行，等待正常启动后核验。" Style="{StaticResource Caption}" Visibility="{Binding EmptyVisibility}"/>
          <ItemsControl ItemsSource="{Binding Instances}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="12" Margin="0,4,0,4"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Pid}" FontWeight="SemiBold" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Outcome}" Style="{StaticResource StatusLabel}"/></Grid><TextBlock Text="{Binding Raw}" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </StackPanel>
        </Expander></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel><TextBlock Text="最近一次自动会话" Style="{StaticResource Caption}"/><TextBlock x:Name="SessionText" Text="尚未执行" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="外观" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="主题立即生效，仅在本机记住选择。" Style="{StaticResource Caption}" Margin="0,8,16,0"/></StackPanel><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center" AutomationProperties.Name="明暗主题"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox></Grid><TextBlock x:Name="AppearanceHint" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="启动相关性策略" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="PersistentAffinity" Content="启动时绑定最后一个逻辑 CPU" Margin="0,16,0,12" AutomationProperties.Name="启动时绑定最后一个逻辑 CPU"/><TextBlock x:Name="AffinityText" Style="{StaticResource Caption}"/><TextBlock Text="默认保持原设置。保存后作用于下次 ACE 启动；已有实例可在诊断页使用一次性绑定。" Style="{StaticResource Caption}" Margin="0,6,0,16"/><WrapPanel><Button x:Name="SaveAffinityButton" Content="保存策略"/><TextBlock x:Name="AffinitySavedText" Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="自动执行与组件" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SettingsVersionText" Style="{StaticResource Caption}" Margin="0,8,0,16"/><WrapPanel><Button x:Name="InstallButton" Content="启用自动管理"/><Button x:Name="UpgradeButton" Content="升级本机组件"/><Button x:Name="PauseButton" Content="暂停自动执行"/><Button x:Name="ResumeButton" Content="恢复自动执行"/></WrapPanel><TextBlock Text="暂停后启动优先级规则和原始备份仍保留。面板关闭不影响每次启动时自动执行。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource ErrorBrush}"><StackPanel><TextBlock Text="完整恢复" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="移除本工具的自动触发和任务，恢复第一次修改前的启动设置。原始备份保留；已有运行实例需要正常重启。" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button x:Name="RestoreButton" Content="完整恢复原设置" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/></StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
       <TextBlock x:Name="HealthText" Text="正在检查各项配置…" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
       <WrapPanel Margin="0,0,0,8"><Button x:Name="DiagnosticButton" Content="预览诊断摘要…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button x:Name="RepairButton" Content="修复自动执行" Margin="0,0,8,8"/><Button x:Name="SelfTestButton" Content="运行自检" Margin="0,0,8,8"/><Button x:Name="LastButton" Content="本次绑定最后 CPU" Margin="0,0,8,8"/></WrapPanel>
       <Border Style="{StaticResource Card}" Padding="16,0"><ItemsControl x:Name="HealthList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Path Style="{StaticResource StatusIcon}"/><TextBlock Text="{Binding Status}" Style="{StaticResource StatusLabel}"/></StackPanel></Grid><TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock Text="{Binding Code}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
       <TextBlock Text="诊断摘要先预览再复制；不会自动上传，也不包含用户名、路径、PID 或原始备份。" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
