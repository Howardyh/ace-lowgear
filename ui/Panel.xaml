<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ACE LowGear · 控制中心" Width="1060" Height="760" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" Background="#F4F6FA" Foreground="#17253E">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFD8E8"/><Setter Property="Foreground" Value="#253C60"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2FA"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="28" Background="#F4F6FA">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="ACE LowGear" FontSize="30" FontWeight="Bold"/><TextBlock Text="统一管理 · 让后台为前台让路" Foreground="#687993" Margin="0,6,0,0" FontSize="14"/></StackPanel>
   <Border Grid.Column="1" Background="#E4ECFF" CornerRadius="12" Padding="14,8" VerticalAlignment="Center"><TextBlock Text="1.0.0  /  本地优先" Foreground="#315FBD"/></Border>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
   <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="自动管理" Foreground="#74829A"/><TextBlock x:Name="ManagerText" Text="正在读取…" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU / I/O 目标" Foreground="#74829A"/><TextBlock Text="低 / 非常低" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="相关性策略" Foreground="#74829A"/><TextBlock x:Name="AffinityText" Text="保持原设置" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
  </UniformGrid>
  <StackPanel Grid.Row="2" Margin="0,0,0,14">
   <WrapPanel>
    <Button x:Name="InstallButton" Content="启用自动管理" Background="#285BD6" Foreground="White" BorderBrush="#285BD6"/>
    <Button x:Name="ApplyButton" Content="立即应用一次"/>
    <Button x:Name="PauseButton" Content="暂停自动执行"/>
    <Button x:Name="ResumeButton" Content="恢复自动执行"/>
    <Button x:Name="RefreshButton" Content="刷新状态"/>
   </WrapPanel>
   <WrapPanel>
    <Button x:Name="LastButton" Content="本次绑定最后 CPU"/>
    <Button x:Name="SelfTestButton" Content="运行自检"/>
    <Button x:Name="RestoreButton" Content="完整恢复原设置" Foreground="#A84C41"/>
    <CheckBox x:Name="PersistentAffinity" Content="启动时也绑定最后一个逻辑 CPU" VerticalAlignment="Center" Margin="10,0,0,8" ToolTip="勾选后点击启用自动管理。每次启动设置并确认一次，完成后退出；已有实例的相关性会保持到正常重启。"/>
   </WrapPanel>
  </StackPanel>
  <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="进程实时状态" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Text="正在检查启动规则与运行实例…" Margin="0,6,0,0" Foreground="#667996" TextWrapping="Wrap"/></StackPanel>
    <DataGrid Grid.Row="1" x:Name="ProcessesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" SelectionMode="Single" RowHeaderWidth="0" RowHeight="38" Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
     <DataGrid.Columns>
      <DataGridTextColumn Header="程序 / PID" Binding="{Binding Name}" Width="200"/>
      <DataGridTextColumn Header="启动规则" Binding="{Binding Startup}" Width="80"/>
      <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="70"/>
      <DataGridTextColumn Header="I/O" Binding="{Binding Io}" Width="80"/>
      <DataGridTextColumn Header="相关性" Binding="{Binding Affinity}" Width="100"/>
      <DataGridTextColumn Header="结果与原因" Binding="{Binding Outcome}" Width="*" MinWidth="170"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" x:Name="DetailText" Text="读取失败会明确显示原因，不会用 0 或 -1 伪装成实际优先级。" Foreground="#74829A" Margin="0,12,0,0" TextWrapping="Wrap"/>
   </Grid>
  </Border>
  <Border Grid.Row="4" Background="#EAF0FA" CornerRadius="10" Padding="14" Margin="0,16,0,0"><StackPanel>
   <TextBlock x:Name="OperationText" Text="就绪。每次 ACE 启动自动执行一次；设置并确认后退出，没有常驻纠错程序。" TextWrapping="Wrap" Foreground="#3F587F"/>
   <TextBlock Text="最低优先级是资源争用时让路，不是占用率限制。内核驱动及独立请求不由进程规则统一控制。" FontSize="11" Foreground="#7988A1" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
 </Grid>
</Window>
